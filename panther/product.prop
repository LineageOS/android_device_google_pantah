# Bluetooth
bluetooth.ble.allow_enc_with_bredr=true
bluetooth.device_id.product_id=16649
bluetooth.leaudio.dual_bidirection_swb.supported=false
bluetooth.leaudio.toggle_visible_for_asha=false
bluetooth.profile.bap.unicast.client.enabled?=true
bluetooth.profile.ccp.server.enabled?=true
bluetooth.profile.csip.set_coordinator.enabled?=true
bluetooth.profile.hap.client.enabled?=true
bluetooth.profile.hap.enabled_by_default=false
bluetooth.profile.mcp.server.enabled?=true
bluetooth.profile.vcp.controller.enabled?=true
persist.bluetooth.bqr.event_mask=94
persist.bluetooth.firmware.selection=BCM.hcd
persist.bluetooth.leaudio.allow_list=SM-R510,WF-1000XM5,SM-R630,WH-1000XM6,880066-0100,LinkBuds Fit,WF-1000XM6
persist.bluetooth.leaudio.allow_list_extend=LinkBuds Open
persist.bluetooth.leaudio.notify.idle.during.call=true
persist.bluetooth.leaudio_offload.disabled=false
persist.bluetooth.opus.enabled=true
ro.bluetooth.leaudio_offload.supported=true
ro.bluetooth.leaudio_switcher.supported=true

# Device family
ro.build.device_family=P10C10L10

# Google keyboard
ro.com.google.ime.height_ratio=1.075
ro.com.google.ime.kb_pad_port_b=8

# Quick start
ro.quick_start.device_id=panther

# Window extensions
persist.settings.large_screen_opt.enabled=false
